# Edge Function secrets.
#   local:  copy to supabase/functions/.env  (git-ignored) and run `npx supabase functions serve`
#   cloud:  npx supabase secrets set --env-file supabase/functions/.env
OPENAI_API_KEY=sk-...

# Models are never hard-coded. Verified on developers.openai.com (2026-10-03): gpt-6-luna
TUTOR_MODEL=gpt-6-luna
# Optional: a different model for parent summaries (defaults to TUTOR_MODEL)
SUMMARY_MODEL=gpt-6-luna

# Optional tuning
TUTOR_REASONING_EFFORT=low
SUMMARY_REASONING_EFFORT=low
TUTOR_IMAGE_DETAIL=high
# Optional: comma separated origins allowed to call the functions (empty = any; auth is by bearer token)
# ALLOWED_ORIGINS=https://YOUR-NAME.github.io

# LINE Login channel for the parent page (LINE Developers console → LINE Login channel → Basic settings)
LINE_CHANNEL_ID=1234567890
LINE_CHANNEL_SECRET=your-channel-secret
