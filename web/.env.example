# Supabase project (Settings → API). The anon / publishable key is safe in the browser because RLS is on.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY
# Login IDs without "@" become <id>@<this domain> (must match LOGIN_DOMAIN used by scripts/create-users.mjs)
VITE_LOGIN_DOMAIN=juku.local
